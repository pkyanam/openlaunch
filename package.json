{
  "name": "openlaunch",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Provider-neutral device capabilities for agents",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "cf": "cf",
    "check": "npm run typecheck && npm run typecheck --workspace @openlaunch/cloud && npm run typecheck --workspace @openlaunch/web && npm run typecheck --workspace @openlaunch/local && npm test",
    "dev:local": "node --import tsx apps/local/src/server.ts",
    "doctor": "node scripts/tasks.mjs doctor",
    "build": "node scripts/tasks.mjs build",
    "build:pi": "node scripts/tasks.mjs pi",
    "build:linux": "node scripts/tasks.mjs pi",
    "build:firmware": "node scripts/tasks.mjs firmware",
    "prepare:firmware": "node scripts/firmware.mjs --prepare-only",
    "setup:firmware": "node scripts/setup-firmware.mjs",
    "test:device": "node scripts/tasks.mjs device-test",
    "test:e2e": "node scripts/tasks.mjs e2e",
    "test:linux": "node scripts/tasks.mjs linux-e2e",
    "verify": "node scripts/tasks.mjs verify",
    "provision:uno": "python3 scripts/provision-uno.py",
    "provision:roomba": "python3 scripts/provision-roomba.py",
    "build:site": "npm run build --workspace @openlaunch/site",
    "check:site": "npm run validate --workspace @openlaunch/site && npm run audit --workspace @openlaunch/site && node scripts/check-docs-mcp.mjs",
    "setup": "npm ci && npm run build --workspace @openlaunch/web && node scripts/start-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "test:cloud-storage": "node scripts/verify-cloud-storage.mjs",
    "test:home-assistant": "node scripts/test-home-assistant.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "cf": "1.0.0-beta.12",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
