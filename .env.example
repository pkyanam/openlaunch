# Set after Cloudflare account verification. Never commit credentials.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# Hosted SDK attachment: server-only JSON keyring with versioned random 32-byte
# hex keys. Store DEVICE_CREDENTIAL_KEYS in deployment secrets, never this file.
# Keep old versions for outstanding 10-minute pairing retries when rotating.
# DEVICE_CREDENTIAL_KEY_VERSION=v1
# Local setup generates a private ignored keyring automatically.
