---
import PageLayout from "blume/components/layout/PageLayout.astro";
import Search from "blume/components/layout/Search.astro";
import data from "blume:data";
import Footer from "./Footer.astro";
interface Props { title: string; description?: string; active?: string; sections?: string[][]; }
const { title, description = data.config.description, active = "Home", sections = [] } = Astro.props;
const { config } = data;
const links = [["Home", "/"], ["Documentation", "/docs"], ["Console", "/console/"], ["Pricing", "/pricing"], ["Updates", "/changelog"]];
---
<PageLayout site={{ title: config.title, description: config.description }}
  logo={{ ...config.logo, dimensions: { light: { width: 1280, height: 1280 }, dark: { width: 1280, height: 1280 } } }} navigation={{ ...data.navigation, tabs: [], actions: [], cta: undefined, selectors: [] }}
  favicon={config.favicon} fontCssVars={data.fontCssVars} themeMode={config.theme.mode}
  searchEnabled={false} siteUrl={config.site} ogEnabled={config.og.enabled} page={{ title, description }}>
  <div class="public-frame">
    <aside class="public-rail" aria-label="Site navigation">
      <div class="rail-top">
        <a class="rail-brand" href="/" aria-label="openlaunch home"><img src="/icon.svg" width="28" height="28" alt="" /><span>openlaunch</span></a>
        <div class="rail-tools">
          <Search navigation={data.navigation} popularPages={config.search.popular} />
          <button type="button" data-blume-theme-toggle aria-label="Toggle theme" class="rail-theme"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 1v2m0 14v2M1 10h2m14 0h2M3.6 3.6 5 5m10 10 1.4 1.4M3.6 16.4 5 15m10-10 1.4-1.4" /></svg></button>
        </div>
      </div>
      <nav class="rail-primary" aria-label="Main navigation">{links.map(([label, href]) => <a href={href} aria-current={active === label ? "page" : undefined}>{label}</a>)}</nav>
      <div class="rail-source"><a href="https://github.com/pkyanam/openlaunch">Open source <span aria-hidden="true">↗</span></a><span>MIT licensed · Self-hostable</span></div>
      {sections.length > 0 && <nav class="rail-sections" aria-label="On this page">{sections.map(([label, id], i) => <a href={"#" + id}><span>{String(i + 1).padStart(2, "0")}</span>{label}</a>)}</nav>}
      <nav class="rail-developers" aria-label="Developer resources"><p>Developers</p><a href="/docs/reference">API reference</a><a href="/docs/cli">ol CLI</a><a href="/docs/agents">Agent connections</a></nav>
      <div class="rail-contact"><span>Building something?</span><a href="mailto:info@belweave.com">Talk to Belweave <span aria-hidden="true">↗</span></a></div>
    </aside>
    <div class="public-content"><slot /></div>
  </div>
  <div class="public-footer" slot="footer"><Footer /></div>
</PageLayout>
<style>
  :global(body:has(.public-frame) > [data-blume-header]) { display: none; }
  :global(body:has(.public-frame) > #blume-content) { padding: 0; }
  .public-frame { --rail-width: 264px; color: var(--blume-foreground, #171717); }
  .public-rail { position: fixed; inset: 0 auto 0 0; z-index: 20; width: var(--rail-width); display: flex; flex-direction: column; gap: 26px; padding: 30px 28px 24px; overflow-y: auto; background: var(--blume-background, #fff); border-right: 1px solid var(--blume-border, #dedede); }
  .rail-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .rail-brand { display: flex; align-items: center; gap: 9px; color: inherit; font-size: 19px; font-weight: 650; letter-spacing: -.6px; text-decoration: none; }
  .rail-brand img { width: 24px; height: 24px; object-fit: contain; }
  :global([data-theme="dark"]) .rail-brand img { filter: invert(1); }
  .rail-tools { display: flex; align-items: center; gap: 2px; }
  .rail-tools :global([data-blume-search-open]), .rail-theme { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 32px; padding: 0; color: var(--blume-muted-foreground, #666); border: 0; background: transparent; cursor: pointer; border-radius: 5px; }
  .rail-tools :global([data-blume-search-open]:hover), .rail-theme:hover { background: var(--blume-muted, #f5f5f5); }
  .rail-primary, .rail-developers { display: grid; gap: 4px; }
  .public-rail nav a { text-decoration: none; color: var(--blume-muted-foreground, #666); }
  .rail-primary a { position: relative; padding: 5px 0 5px 13px; font-size: 15px; line-height: 1.5; }
  .rail-primary a[aria-current="page"] { color: var(--blume-foreground, #171717); font-weight: 550; }
  .rail-primary a[aria-current="page"]::before { content: ""; position: absolute; left: 0; top: 9px; bottom: 9px; width: 1.5px; background: currentColor; }
  .public-rail a:hover { color: var(--blume-foreground, #171717); }
  .rail-source { display: grid; gap: 8px; border-top: 1px solid var(--blume-border, #dedede); padding-top: 18px; font-size: 12px; color: var(--blume-muted-foreground, #666); }
  .rail-source a { display: flex; justify-content: space-between; color: inherit; text-decoration: none; }
  .rail-source > span { font-size: 11px; }
  .rail-sections { display: grid; gap: 11px; }
  .rail-sections a { display: flex; gap: 10px; font-size: 11px; font-family: var(--font-mono, ui-monospace), monospace; }
  .rail-sections a span { opacity: .65; }
  .rail-developers { margin-top: 4px; }
  .rail-developers p { margin: 0 0 6px; font-size: 10px; letter-spacing: .08em; color: var(--blume-muted-foreground, #666); }
  .rail-developers a { font-size: 12px; padding: 3px 0; }
  .rail-contact { display: grid; gap: 7px; margin-top: auto; padding-top: 20px; border-top: 1px solid var(--blume-border, #dedede); font-size: 11px; color: var(--blume-muted-foreground, #666); }
  .rail-contact a { color: var(--blume-foreground, #171717); font-size: 12px; text-decoration: none; }
  .public-content, .public-footer { margin-left: 264px; }
  .public-content { min-width: 0; }
  .public-rail a:focus-visible, .rail-theme:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 1050px) { .public-frame { --rail-width: 232px; } .public-rail { padding-inline: 22px; } .public-content, .public-footer { margin-left: 232px; } .rail-brand { font-size: 17px; gap: 6px; } }
  @media (max-width: 800px) {
    .public-rail { position: static; width: 100%; padding: 18px 24px 14px; gap: 16px; border-right: 0; border-bottom: 1px solid var(--blume-border, #dedede); }
    .rail-top { width: 100%; } .rail-brand { font-size: 19px; } .rail-tools { gap: 8px; }
    .rail-primary { display: flex; flex-wrap: wrap; gap: 10px 22px; }
    .rail-primary a { font-size: 13px; padding: 3px 0; } .rail-primary a[aria-current="page"]::before { top: auto; bottom: -3px; width: 100%; height: 1px; }
    .rail-source, .rail-sections, .rail-developers, .rail-contact { display: none; }
    .public-content, .public-footer { margin-left: 0; }
  }
</style>
